<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>simple_breath_animator</name>
  <version>0.0.1</version>
  <description>
    Default breath animator plugin for Expression.
    Animates breathing with randomly-generated values.
  </description>
  <maintainer email="humansbadrobotsgood@gmail.com">tomicodev</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  
  <depend>ament_index_cpp</depend>
  <depend>behaviortree_cpp</depend>
  <depend>expression</depend>
  <depend>pluginlib</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
